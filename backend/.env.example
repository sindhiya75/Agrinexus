ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AgriNexus AI"
API_V1_STR="/api/v1"

# Database connection
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrinexus_db
POSTGRES_USER=agrinexus_user
POSTGRES_PASSWORD=agrinexus_password

# Security & JWT
# IMPORTANT: Generate a strong secret (e.g. using `openssl rand -hex 32`) for production
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256

# ML Models Directory (optional override)
MODEL_DIR=ml/models

# CORS Settings (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
