# ==============================================================================
# AgriNexus AI — Environment Configuration
# ==============================================================================

# General
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AgriNexus AI"
API_V1_STR="/api/v1"

# Database (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrinexus_db
POSTGRES_USER=agrinexus_user
POSTGRES_PASSWORD=agrinexus_password

# For Docker Compose internal networking, POSTGRES_SERVER is 'db'
# DOCKER_POSTGRES_SERVER=db

# Backend API Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Frontend App Service
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
